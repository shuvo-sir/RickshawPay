{
  "expo": {
    "name": "RickshawPay",
    "slug": "rickshaw-pay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/rickshaw.png",
    "scheme": "rickshawpay",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.shuvosir.rickshawpay",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "147e98ac-7a28-4a98-969c-ac6ed85ee26b"
      }
    },
    "owner": "shuvo-sir"
  }
}
